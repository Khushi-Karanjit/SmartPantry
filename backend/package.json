{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --verbose smartpantry.test.js",
    "test:system": "jest --verbose smartpantry.system.test.js --testTimeout=30000 --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "SmartPantry — Unit Test Results",
          "outputPath": "./test-report.html",
          "includeFailureMsg": true,
          "includeConsoleLog": false,
          "theme": "lightTheme"
        }
      ]
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "youtube-captions-scraper": "^2.0.3",
    "youtube-transcript": "^1.3.0",
    "youtube-transcript-api": "^3.0.6",
    "ytranscript": "^1.1.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "jest-html-reporter": "^4.4.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
